# Porta onde o servidor Node.js irá rodar localmente
PORT=3000

# Dados de Conexão com o Supabase (encontrados em Project Settings > API no painel do Supabase)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Recomendado usar a service_role secret ou anon public key
SUPABASE_KEY=sua_chave_supabase_aqui

# Nome da tabela no Supabase (sua tabela: leads_grupos)
SUPABASE_TABLE=leads_grupos

# Token de Segurança Sendhook (SENDTOK mostrado no painel do Sendflow)
# Se configurado, qualquer requisição sem esse token será rejeitada com 401
# Se deixar em branco, o webhook aceitará todas as requisições
SENDTOK=5C976380744A2E92434AE17B856A3F03505E9A971B
